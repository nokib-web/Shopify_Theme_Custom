{{ 'section-hero-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign first_block = section.blocks.first
  assign first_mobile_height = first_block.settings.mobile_media_height | default: 280
  assign desktop_aspect = first_block.settings.desktop_aspect_ratio | default: '16/9'

  assign desktop_ratio = desktop_aspect
  if desktop_ratio == 'adapt'
    if first_block and first_block.settings.desktop_bg_image != blank
      assign desktop_ratio = first_block.settings.desktop_bg_image.aspect_ratio
    else
      assign desktop_ratio = '16/9'
    endif
  endif
-%}

{%- style -%}
  /* Section Padding and Layout */
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top | times: 0.75 | round: 0 }}px + var(--additional-padding, 0px));
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: calc({{ section.settings.padding_top }}px + var(--additional-padding, 0px));
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Transparent Header integration */
  {% if section.settings.transparent_header %}
    .hero-slider-{{ section.id }} {
      margin-top: calc(var(--header-height) * -1);
      --additional-padding: var(--header-height);
    }
    .section-header:not(.scrolled-past-header) .header-wrapper {
      background: none !important;
      transition: background 0.2s;
      border-bottom: none !important;
    }
    .section-header:not(.scrolled-past-header) .header__icon,
    .section-header:not(.scrolled-past-header) .header__menu-item--main {
      --color-foreground: var(--color-base-{{ section.settings.transparent_header_text_color }});
      transition: color 0.2s;
    }
    .section-header:not(.scrolled-past-header) .header__menu-item--main:hover {
      --color-foreground: var(--color-base-{{ section.settings.transparent_header_hover_link_color }});
      color: rgb(var(--color-foreground));
    }
    .section-header:not(.scrolled-past-header) .header-wrapper .header__active-menu-item-v2 {
      --color-background: var(--color-base-{{ section.settings.transparent_header_text_color }});
      --color-foreground: var(--color-base-{{ section.settings.transparent_header_highlighted_link_color }});
      transition: background 0.2s, color 0.2s;
    }
    {% if section.settings.transparent_header_logo == 'secondary' %}
      .section-header:not(.scrolled-past-header) .header-wrapper .header__heading-logo--main {
        display: none !important;
      }
      .section-header:not(.scrolled-past-header) .header-wrapper .header__heading-logo--secondary {
        display: inline-block !important;
      }
    {% endif %}
  {% endif %}

  /* Dynamic Height Rules */
  {% if section.settings.min_desktop_height_type == 'aspect-ratio' %}
    @media screen and (min-width: 750px) {
      .hero-slider-{{ section.id }} {
        height: auto !important;
        aspect-ratio: {{ desktop_ratio }};
      }
      .hero-slider-{{ section.id }} .splide,
      .hero-slider-{{ section.id }} .splide__track,
      .hero-slider-{{ section.id }} .splide__list,
      .hero-slider-{{ section.id }} .splide__slide,
      .hero-slider-{{ section.id }} .hero-slide {
        height: 100% !important;
      }
    }
  {% elsif section.settings.min_desktop_height_type != 'autofit' %}
    @media screen and (min-width: 750px) {
      .hero-slider-{{ section.id }},
      .hero-slider-{{ section.id }} .splide,
      .hero-slider-{{ section.id }} .splide__track,
      .hero-slider-{{ section.id }} .splide__list,
      .hero-slider-{{ section.id }} .splide__slide,
      .hero-slider-{{ section.id }} .hero-slide {
        height: 100%;
      }
      .hero-slider-{{ section.id }} {
        {% if section.settings.min_desktop_height_type == 'pixels' %}
          height: {{ section.settings.desktop_pixels_height }}px;
        {% elsif section.settings.min_desktop_height_type == '100vh' %}
          height: 100vh;
        {% endif %}
      }
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .hero-slider-{{ section.id }},
    .hero-slider-{{ section.id }} .splide,
    .hero-slider-{{ section.id }} .splide__track,
    .hero-slider-{{ section.id }} .splide__list,
    .hero-slider-{{ section.id }} .splide__slide,
    .hero-slider-{{ section.id }} .hero-slide {
      height: auto !important;
      min-height: auto !important;
    }
    .hero-slider-{{ section.id }} {
      --mobile-media-height-value: {{ first_mobile_height }}px;
    }
  }

  /* Dynamic Colors and Background */
  .hero-slider-{{ section.id }} {
    background-color: rgb(var(--color-background));
  }

  .hero-slider-{{ section.id }} .hero__heading-prefix {
    color: {{ section.settings.prefix_color | default: '#00D1A0' }};
  }

  .hero-slider-{{ section.id }} .button--primary {
    background-color: {{ section.settings.btn_bg_color | default: '#00D1A0' }};
    color: {{ section.settings.btn_text_color | default: '#fff' }};
  }

  .hero-slider-{{ section.id }} .button--primary:hover {
    background-color: {{ section.settings.btn_hover_bg_color | default: '#00B88F' }};
  }

  .hero-slider-{{ section.id }} .hero-slider__thumbnail-card.is-active {
    border-color: {{ section.settings.btn_bg_color | default: '#00D1A0' }};
  }
{%- endstyle -%}

<div class="hero-slider-container hero-slider-{{ section.id }} {{ section.settings.visibility }}" data-transition-style="{{ section.settings.slider_type }}">
  <hero-slider
    data-autoplay="{{ section.settings.autoplay }}"
    data-autoplay-speed="{{ section.settings.autoplay_speed }}"
    data-drag="{{ section.settings.drag }}"
    data-type="{{ section.settings.slider_type }}"
  >
    <div class="splide">
      <div class="splide__track">
        <ul class="splide__list">
          {% for block in section.blocks %}
            {% liquid
              assign has_desktop_bg = false
              if block.settings.desktop_bg_image != blank or block.settings.desktop_bg_video != blank
                assign has_desktop_bg = true
              endif
              assign has_mobile_bg = false
              if block.settings.mobile_bg_image != blank or block.settings.mobile_bg_video != blank
                assign has_mobile_bg = true
              endif

              assign overlay_opacity = block.settings.overlay_opacity
              assign overlay_color = block.settings.overlay_color
            %}
            <li
              class="splide__slide"
              data-bg-zoom="{{ block.settings.enable_bg_zoom }}"
              data-content-animation="{{ block.settings.content_animation }}"
              {{ block.shopify_attributes }}
            >
              <div
                class="hero-slide"
                style="
                  --content-max-width: {{ block.settings.content_max_width }}px;
                  --content-vertical-position: {{ block.settings.content_vertical_position }};
                  --content-horizontal-position: {{ block.settings.content_horizontal_position }};
                  --content-text-alignment: {{ block.settings.content_text_alignment }};
                  --mobile-content-vertical-position: {{ block.settings.mobile_content_vertical_position }};
                  --mobile-content-text-alignment: {{ block.settings.mobile_content_text_alignment }};
                  --overlay-color: {{ overlay_color }};
                  --overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }};
                  --mobile-content-bg: {% if block.settings.mobile_content_bg != blank %}{{ block.settings.mobile_content_bg }}{% else %}rgb(var(--color-background)){% endif %};
                  --mobile-media-height: {{ block.settings.mobile_media_height | default: 280 }}px;
                "
              >
                <!-- Background Media -->
                <div class="hero-slide__background media media--transparent{% if has_mobile_bg %} hero-slide__background--has-mobile{% endif %}">
                  {% if has_desktop_bg %}
                    {% if block.settings.desktop_bg_video != blank %}
                      <video
                        width="100%"
                        height="auto"
                        preload="metadata"
                        poster="{{ block.settings.desktop_bg_video.preview_image | image_url }}"
                        loop
                        muted
                        playsinline
                        disablepictureinpicture
                        class="hero-slide__background__desktop-media"
                      >
                        {% for source in block.settings.desktop_bg_video.sources %}
                          <source src="{{ source.url }}" type="{{ source.mime_type }}">
                        {% endfor %}
                      </video>
                    {% else %}
                      {{
                        block.settings.desktop_bg_image
                        | image_url: width: 3840
                        | image_tag:
                          loading: 'lazy',
                          sizes: '100vw',
                          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                          class: 'hero-slide__background__desktop-media'
                      }}
                    {% endif %}
                  {% else %}
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}

                  {% if has_mobile_bg %}
                    {% if block.settings.mobile_bg_video != blank %}
                      <video
                        width="100%"
                        height="auto"
                        preload="metadata"
                        poster="{{ block.settings.mobile_bg_video.preview_image | image_url }}"
                        loop
                        muted
                        playsinline
                        disablepictureinpicture
                        class="hero-slide__background__mobile-media desktop-hidden"
                      >
                        {% for source in block.settings.mobile_bg_video.sources %}
                          <source src="{{ source.url }}" type="{{ source.mime_type }}">
                        {% endfor %}
                      </video>
                    {% else %}
                      {{
                        block.settings.mobile_bg_image
                        | image_url: width: 1500
                        | image_tag:
                          loading: 'lazy',
                          sizes: '100vw',
                          widths: '375, 550, 750, 1100, 1500',
                          class: 'hero-slide__background__mobile-media desktop-hidden'
                      }}
                    {% endif %}
                  {% endif %}
                </div>

                <!-- Overlay -->
                <div class="hero-slide__overlay">&nbsp</div>

                <!-- Content Overlay -->
                <div class="hero-slide__content-container page-width section-{{ section.id }}-padding">
                  <div class="hero-slide__content animate-item">
                    {% if block.settings.heading_prefix != blank %}
                      <p class="hero__heading-prefix">
                        {{ block.settings.heading_prefix }}
                      </p>
                    {% endif %}
                    {% if block.settings.heading != blank %}
                      <h2 class="hero__heading {{ block.settings.heading_size }}">
                        {{ block.settings.heading }}
                      </h2>
                    {% endif %}
                    {% if block.settings.text != blank %}
                      <div class="hero__text rte">
                        {{ block.settings.text }}
                      </div>
                    {% endif %}
                    {% if block.settings.button_label != blank %}
                      <div class="hero__buttons">
                        <a
                          href="{{ block.settings.button_link | default: '#' }}"
                          class="button button--primary button--pill"
                        >
                          {{ block.settings.button_label | escape }}
                        </a>
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <!-- Thumbnail navigation bottom left -->
    {% if section.blocks.size > 1 %}
      <ul class="hero-slider__thumbnails">
        {% for block in section.blocks %}
          {% liquid
            assign thumb_img = block.settings.thumbnail_image
            if thumb_img == blank
              assign thumb_img = block.settings.desktop_bg_image
            endif
          %}
          <li
            class="hero-slider__thumbnail-card{% if forloop.first %} is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
          >
            {% if thumb_img != blank %}
              <img
                src="{{ thumb_img | image_url: width: 200 }}"
                alt="{{ block.settings.heading | default: 'Slide Thumbnail' }}"
                loading="lazy"
                width="80"
                height="110"
              >
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </li>
        {% endfor %}
      </ul>

      <!-- Navigation arrows bottom right -->
      <div class="hero-slider__nav">
        <button class="hero-slider__arrow hero-slider__arrow--prev" aria-label="Previous Slide">
          <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
        </button>
        <button class="hero-slider__arrow hero-slider__arrow--next" aria-label="Next Slide">
          <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </button>
      </div>
    {% endif %}
  </hero-slider>
</div>

<script src="{{ 'hero-slider.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Hero Slider",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "options": [
        {
          "value": "desktop-hidden",
          "label": "Mobile only"
        },
        {
          "value": "mobile-hidden",
          "label": "Desktop only"
        },
        {
          "value": "always-display",
          "label": "All devices"
        }
      ],
      "label": "Display on",
      "default": "always-display"
    },
    {
      "type": "header",
      "content": "Aesthetics & Colors"
    },
    {
      "type": "color",
      "id": "prefix_color",
      "label": "Heading prefix text color",
      "default": "#00D1A0"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Primary Button / Active border color",
      "default": "#00D1A0"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Primary Button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_hover_bg_color",
      "label": "Primary Button hover color",
      "default": "#00B88F"
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "select",
      "id": "min_desktop_height_type",
      "label": "Minimum desktop height",
      "options": [
        {
          "value": "autofit",
          "label": "Autofit (size of content)"
        },
        {
          "value": "pixels",
          "label": "Amount in pixels"
        },
        {
          "value": "aspect-ratio",
          "label": "Aspect Ratio"
        },
        {
          "value": "100vh",
          "label": "Viewport height (100vh)"
        }
      ],
      "default": "pixels"
    },
    {
      "type": "number",
      "id": "desktop_pixels_height",
      "label": "Desktop minimum height in pixels",
      "default": 650
    },
    {
      "type": "select",
      "id": "min_mobile_height_type",
      "label": "Minimum mobile height",
      "options": [
        {
          "value": "autofit",
          "label": "Autofit (size of content)"
        },
        {
          "value": "pixels",
          "label": "Custom amount of pixels"
        },
        {
          "value": "100vh",
          "label": "Viewport height (100vh)"
        }
      ],
      "default": "pixels"
    },
    {
      "type": "number",
      "id": "mobile_pixels_height",
      "label": "Mobile minimum height in pixels",
      "default": 450
    },
    {
      "type": "header",
      "content": "Transparent Header"
    },
    {
      "type": "checkbox",
      "id": "transparent_header",
      "label": "Transparent header integration",
      "default": false,
      "info": "Fits the slider under the header and sets transparent background. Scrolled header is unaffected."
    },
    {
      "type": "select",
      "id": "transparent_header_text_color",
      "options": [
        {
          "value": "accent-1",
          "label": "Accent 1"
        },
        {
          "value": "accent-2",
          "label": "Accent 2"
        },
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        },
        {
          "value": "text",
          "label": "Text"
        }
      ],
      "default": "text",
      "label": "Header links and icons color"
    },
    {
      "type": "select",
      "id": "transparent_header_highlighted_link_color",
      "options": [
        {
          "value": "accent-1",
          "label": "Accent 1"
        },
        {
          "value": "accent-2",
          "label": "Accent 2"
        },
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        },
        {
          "value": "text",
