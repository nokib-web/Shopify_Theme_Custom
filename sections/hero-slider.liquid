          "default": "Expert Approved Setup"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Main Heading",
          "default": "Optimal Heating & Lights"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
